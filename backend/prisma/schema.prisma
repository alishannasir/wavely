generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  GUEST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AppealStatus {
  OPEN
  APPROVED
  REJECTED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum BanType {
  IP
  DEVICE
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum SubscriptionPlan {
  FREE
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ReportReason {
  NUDITY
  HARASSMENT
  MINOR_CONCERN
  SPAM
  OTHER
}

enum CallKind {
  RANDOM
  FRIEND
}

enum IdentityStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  REVIEW
}

enum GateState {
  PAUSED_VERIFY
  RESUMED
  BLOCKED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
}

model User {
  id                String       @id @default(cuid())
  email             String?      @unique
  // Guests: random chat only, no email. Self-attested 18+ (adultAttestedAt) instead of a birthdate.
  isGuest           Boolean      @default(false)
  adultAttestedAt   DateTime?
  // Proof the user controls the mailbox (set when they click the link; Google accounts are pre-verified).
  emailVerifiedAt   DateTime?
  // Bumped on password change/reset and email change: older login tokens stop working.
  tokenVersion      Int          @default(0)
  // Set when the account was deleted but the row is kept (anonymised) for moderation records.
  deletedAt         DateTime?
  passwordHash      String?
  authProvider      AuthProvider
  displayName       String?
  avatarUrl         String?
  birthdate         DateTime?
  gender            Gender?
  country           String?
  createdAt         DateTime     @default(now())
  trialEndsAt       DateTime
  currentStreak     Int          @default(0)
  lastActiveDate    DateTime?
  creditCents       Int          @default(0)
  status            UserStatus   @default(ACTIVE)
  role              UserRole     @default(USER)
  rulesAcceptedAt   DateTime?
  // While in the future, the user is only matched with other flagged users (shadow queue).
  flaggedUntil      DateTime?
  lastDeviceId      String?
  lastIp            String?
  // Set only by the identity provider's signed webhook (never from the profile form). Once set,
  // birthdate and gender are read-only and come from the verified document.
  idVerifiedAt      DateTime?
  verifiedBirthdate DateTime?
  verifiedSex       Gender?

  subscriptions    Subscription[]
  sessionsAsA      CallSession[]          @relation("SessionUserA")
  sessionsAsB      CallSession[]          @relation("SessionUserB")
  friendsAsA       Friend[]               @relation("FriendUserA")
  friendsAsB       Friend[]               @relation("FriendUserB")
  sentMessages     Message[]              @relation("MessageSender")
  receivedMessages Message[]              @relation("MessageReceiver")
  reportsMade      Report[]               @relation("ReportReporter")
  reportsReceived  Report[]               @relation("ReportReported")
  dailyUsage       DailyUsage[]
  appeals          Appeal[]
  emailTokens      EmailToken[]
  blocksMade       Block[]                @relation("BlockBlocker")
  blocksReceived   Block[]                @relation("BlockBlocked")
  identityChecks   IdentityVerification[]

  @@index([isGuest, createdAt])
  @@map("users")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  user                 User               @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

model CallSession {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  roomId    String?
  kind      CallKind  @default(RANDOM)
  userA     User      @relation("SessionUserA", fields: [userAId], references: [id])
  userB     User      @relation("SessionUserB", fields: [userBId], references: [id])
  reports   Report[]
  gate      RoomGate?

  @@index([userAId])
  @@index([userBId])
  @@index([endedAt, startedAt])
  @@map("sessions")
}

model Friend {
  id        String       @id @default(cuid())
  userAId   String
  userBId   String
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())
  userA     User         @relation("FriendUserA", fields: [userAId], references: [id])
  userB     User         @relation("FriendUserB", fields: [userBId], references: [id])

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friends")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, createdAt])
  @@map("messages")
}

model Report {
  id                String       @id @default(cuid())
  reporterId        String
  reportedUserId    String
  sessionId         String?
  reasonCode        ReportReason
  status            ReportStatus @default(OPEN)
  createdAt         DateTime     @default(now())
  reviewedById      String?
  reviewedAt        DateTime?
  resolution        String?
  // Evidence: a JPEG data URL of the reported user's video frame and the recent chat log.
  // Purged after EVIDENCE_RETENTION_DAYS (default 30), see ReportsService.purgeExpiredEvidence.
  evidenceImage     String?      @db.Text
  chatLog           Json?
  evidenceExpiresAt DateTime?
  // USER = filed by a person, AUTO_NSFW = raised by the viewer's on-device classifier.
  source            String       @default("USER")
  nsfwScore         Float?
  // Legal hold: evidence is kept (never purged) until an administrator releases it. Used when a
  // report is escalated (e.g. suspected child abuse) so it can be preserved and reported.
  legalHold         Boolean      @default(false)
  escalatedAt       DateTime?
  escalatedById     String?
  escalationNote    String?
  reporter          User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reported          User         @relation("ReportReported", fields: [reportedUserId], references: [id])
  session           CallSession? @relation(fields: [sessionId], references: [id])

  // One report per reporter/target/session (sessionId is required by the API).
  @@unique([reporterId, reportedUserId, sessionId])
  @@index([reportedUserId, status])
  @@index([evidenceExpiresAt])
  @@map("reports")
}

model DailyUsage {
  userId      String
  date        DateTime @db.Date
  minutesUsed Int      @default(0)
  matchesUsed Int      @default(0)
  user        User     @relation(fields: [userId], references: [id])

  @@id([userId, date])
  @@map("daily_usage")
}

// Configurable free-tier caps; null means unlimited. Never hardcode limits in code.
model PlanLimit {
  plan           SubscriptionPlan @id
  dailyMinutes   Int?
  dailyMatches   Int?
  adsEnabled     Boolean          @default(false)
  filtersEnabled Boolean          @default(true)

  @@map("plan_limits")
}

// IP / device bans. User-level bans use User.status = BANNED.
model Ban {
  id          String    @id @default(cuid())
  type        BanType
  value       String
  reason      String?
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([type, value])
  @@map("bans")
}

// Every moderator/admin action, for accountability. Never edited or deleted by the app.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String // REPORT_RESOLVED, REPORT_ESCALATED, HOLD_RELEASED, USER_STATUS, ROLE_CHANGED, ...
  targetUserId String?
  reportId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@index([reportId])
  @@map("audit_logs")
}

// "Never match or contact me again". Symmetric in effect: neither side can be matched with, add or
// message the other. Mirrored into Redis (mm:block:<userId>) for the matching script.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// A suspended or banned user asks for the decision to be reviewed (they sign in with email + password
// on /appeal, since a banned account cannot log in). One open appeal at a time, with a cooldown.
model Appeal {
  id           String       @id @default(cuid())
  userId       String
  message      String       @db.Text
  status       AppealStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("appeals")
}

// One-time links sent by email. Only a SHA-256 hash of the secret is stored.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  newEmail  String? // CHANGE_EMAIL: the address being confirmed
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

// One identity check by a third-party provider. Only the provider reference and the outcome are kept,
// never the document or face images.
model IdentityVerification {
  id              String         @id @default(cuid())
  userId          String
  provider        String
  providerRef     String         @unique
  status          IdentityStatus @default(PENDING)
  reasonCode      String?
  documentCountry String?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("identity_verifications")
}

// Webhooks are retried by providers; this makes handling them idempotent.
model IdentityWebhookEvent {
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@id([provider, eventId])
  @@map("identity_webhook_events")
}

// A friend call that was paused because the conversation turned sexual. Resumes only when both
// people have a verified adult identity.
model RoomGate {
  id        String      @id @default(cuid())
  sessionId String      @unique
  userAId   String
  userBId   String
  state     GateState
  trigger   String // VIDEO | TEXT
  score     Float?
  pausedAt  DateTime    @default(now())
  decidedAt DateTime?
  reason    String? // why it was blocked
  session   CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([state, pausedAt])
  @@map("room_gates")
}
