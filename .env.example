# --- Backend ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videochat
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
PORT=3000
FRONTEND_URL=http://localhost:5173

# Geo-gate: when GEO_STRICT=true, requests without a CF-IPCountry header are blocked.
GEO_STRICT=false
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to US/GB/CA/EU/AU/NZ/AE/SA/QA/KW when unset.
ALLOWED_COUNTRIES=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Apple Sign-In (stubbed in Phase 1; wire passport-apple when keys are available)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# LiveKit (media SFU) - media flows through LiveKit, never our servers
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Moderation: auto-suspend a user after this many open reports
REPORT_AUTO_SUSPEND_THRESHOLD=5

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
