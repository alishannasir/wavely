# --- Production (docker-compose.prod.yml, see docs/DEPLOY.md) ---
# Public hostname served by Caddy (HTTPS is automatic). CADDY_ADDRESS=:80 serves plain HTTP instead.
DOMAIN=
CADDY_ADDRESS=

# --- Backend ---
# Used by docker-compose (and to build the URLs below). Change these.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
# Required, >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/videochat
REDIS_URL=redis://:change-me-redis@localhost:6379
PORT=3000
# docker compose only: host ports (containers keep their normal ports). Change them if something
# else on your machine already uses 3000 / 5432 / 6379.
BACKEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_URL=http://localhost:5173

# Geo-gate (HTTP + sockets). The country comes from Cloudflare's CF-IPCountry header, which is only
# trusted when TRUST_PROXY=true. With GEO_STRICT=true, requests of unknown country are blocked, so
# only enable it when the app is reachable exclusively through Cloudflare (and TRUST_PROXY=true).
GEO_STRICT=false
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to US/CA/AU/NZ/EU/AE/SA/QA/KW when unset.
# The UK (GB) is blocked by default until real age verification exists (see docs/MODERATION.md).
ALLOWED_COUNTRIES=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If you change the backend port, change it here too (and in the Google console)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Apple Sign-In (stubbed in Phase 1; wire passport-apple when keys are available)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# LiveKit (media SFU) - media flows through LiveKit, never our servers
LIVEKIT_URL=wss://your-livekit-host
# Optional: address the BACKEND uses to reach LiveKit when it differs from the browser's LIVEKIT_URL
# (e.g. backend in Docker, LiveKit on your machine: http://host.docker.internal:7880)
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Moderation: auto-suspend a user after this many open reports
REPORT_AUTO_SUSPEND_THRESHOLD=5

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# Trust CF-Connecting-IP / X-Forwarded-For for IP bans (only behind Cloudflare / a reverse proxy)
TRUST_PROXY=false
# Days to keep report screenshots / chat logs (legal review needed for serious reports, see docs/MODERATION.md)
EVIDENCE_RETENTION_DAYS=30
# ... and for reports that led to a suspension or ban
EVIDENCE_ACTIONED_RETENTION_DAYS=90
# Comma-separated emails that become administrators when the API starts (register the account first, then restart)
ADMIN_EMAILS=

# Matching: ms a user waits before their country / gender preference is ignored
MM_RELAX_COUNTRY_MS=15000
MM_RELAX_GENDER_MS=30000

# Guest mode (random chat without an account): max guest sessions per day
GUEST_PER_IP_PER_DAY=10
GUEST_PER_DEVICE_PER_DAY=3
