# --- Backend ---
# Used by docker-compose (and to build the URLs below). Change these.
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
# Required, >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=

DATABASE_URL=postgresql://postgres:change-me-postgres@localhost:5432/videochat
REDIS_URL=redis://:change-me-redis@localhost:6379
PORT=3000
FRONTEND_URL=http://localhost:5173

# Geo-gate (HTTP + sockets). The country comes from Cloudflare's CF-IPCountry header, which is only
# trusted when TRUST_PROXY=true. With GEO_STRICT=true, requests of unknown country are blocked, so
# only enable it when the app is reachable exclusively through Cloudflare (and TRUST_PROXY=true).
GEO_STRICT=false
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to US/GB/CA/EU/AU/NZ/AE/SA/QA/KW when unset.
ALLOWED_COUNTRIES=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Apple Sign-In (stubbed in Phase 1; wire passport-apple when keys are available)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# LiveKit (media SFU) - media flows through LiveKit, never our servers
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Moderation: auto-suspend a user after this many open reports
REPORT_AUTO_SUSPEND_THRESHOLD=5

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# Trust CF-Connecting-IP / X-Forwarded-For for IP bans (only behind Cloudflare / a reverse proxy)
TRUST_PROXY=false
# Days to keep report screenshots / chat logs (legal review needed for serious reports, see docs/MODERATION.md)
EVIDENCE_RETENTION_DAYS=30

# Matching: ms a user waits before their country / gender preference is ignored
MM_RELAX_COUNTRY_MS=15000
MM_RELAX_GENDER_MS=30000

# Guest mode (random chat without an account): max guest sessions per day
GUEST_PER_IP_PER_DAY=10
GUEST_PER_DEVICE_PER_DAY=3
